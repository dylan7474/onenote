# Copy to .env (gitignored) to enable the Microsoft Graph OneNote integration
# on a `./deploy.sh` run. Without GRAPH_CLIENT_ID the server runs exactly as
# before and needs no Microsoft account. See README "Connect to Microsoft
# OneNote (optional)" for the free Entra app registration these come from.

# Required to switch the feature on. The Entra app's Application (client) ID.
GRAPH_CLIENT_ID=

# Optional. Set it to use a confidential client; leave empty to use PKCE.
GRAPH_CLIENT_SECRET=

# Optional. common | consumers | organizations | <tenant-id>   (default: common)
GRAPH_TENANT=common

# Optional. Must be registered as a redirect URI on the Entra app. When empty,
# deploy.sh defaults it to http://localhost:<port>/api/graph/callback.
GRAPH_REDIRECT_URI=

# Optional. Space-separated OAuth scopes. Default:
#   openid offline_access User.Read Notes.ReadWrite Notes.Create
GRAPH_SCOPES=
